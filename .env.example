# ---------------------------------------------------------------------------
# Cloud-Based Event Management System — example environment file
#
# Every value here has a working default, so this file is entirely optional.
# Copy it to `.env` and edit only what you need:
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------

# HTTP port the server listens on.
PORT=5000

# Bind address. 0.0.0.0 accepts connections from other machines on the network;
# use 127.0.0.1 to keep it local only.
HOST=0.0.0.0

# development | production | test
# 'production' hardens the defaults (a random JWT secret is generated if the
# development secret below has not been changed).
NODE_ENV=development

# --- storage --------------------------------------------------------------

# Where the JSON database files live. Relative paths resolve from the project
# root. The folder is created automatically.
DATA_DIR=./data

# Storage driver: 'json' uses the bundled file database and needs no setup.
# 'mongodb' is reserved for the Mongoose implementation described in the README.
DB_DRIVER=json

# Only used when DB_DRIVER=mongodb
# MONGO_URI=mongodb://localhost:27017/cbems

# --- authentication -------------------------------------------------------

# CHANGE THIS before deploying anywhere real. Tokens signed with the default
# secret can be forged by anyone who has read this file.
JWT_SECRET=cbems-development-secret-change-me

# How long a sign-in lasts, in seconds. Default is 8 hours.
JWT_EXPIRES_IN_SECONDS=28800

# --- api ------------------------------------------------------------------

# Which origin may call the API from a browser. '*' allows any origin, which is
# convenient in development. Set a single origin in production, e.g.
# CORS_ORIGIN=https://events.example.edu
CORS_ORIGIN=*
